<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.shukantpal.zigzag</string>
  <key>ProgramArguments</key>
  <array>
    <string>/REPLACE/WITH/ABSOLUTE/PATH/zigzag</string>
    <string>--secret-file</string>
    <string>/Users/REPLACE/.codex/zigzag/zigzag.token</string>
    <string>--state-file</string>
    <string>/Users/REPLACE/.codex/zigzag/events.json</string>
    <string>--watch-repo</string>
    <string>leveled-inc/leveled</string>
    <string>--watch-interval</string>
    <string>30</string>
    <string>--watch-pr-state</string>
    <string>/Users/REPLACE/.codex/zigzag/pr_sessions.json</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/REPLACE/.codex/zigzag/zigzag.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE/.codex/zigzag/zigzag.error.log</string>
</dict>
</plist>
