#!/bin/sh
# Run the fast CI gates before accepting a commit. The heavier Clippy gate runs
# from pre-push so ordinary commits stay reasonably quick.

set -eu

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

"$repo_root/scripts/githooks/materialize-config"

cd "$repo_root"

# Hooks inherit Git's repository environment. The Python suite creates its own
# temporary repositories, which must not accidentally use this worktree's
# index or hooks directory.
unset $(git rev-parse --local-env-vars)

echo 'pre-commit: cargo fmt --all --check'
cargo fmt --all --check

echo 'pre-commit: Python checks'
python3 dept/config.py --check
python3 -c "import pathlib; [compile(p.read_text(), str(p), 'exec') for p in pathlib.Path('dept').glob('*.py')]"
python3 -m unittest discover -s dept -p 'test_*.py'
python3 scripts/test_opencode_launch.py
