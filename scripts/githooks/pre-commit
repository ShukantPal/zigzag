#!/bin/sh
# Run the fast CI gates before accepting a commit. The heavier Clippy gate runs
# from pre-push so ordinary commits stay reasonably quick.

set -eu

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

cd "$repo_root"

# Hooks inherit Git's repository environment. Keep temporary repository
# operations from accidentally using this worktree's index or hooks directory.
unset $(git rev-parse --local-env-vars)

echo 'pre-commit: cargo fmt --all'
cargo fmt --all
git add -u -- '*.rs'

echo 'pre-commit: launcher check'
python3 scripts/test_opencode_launch.py
