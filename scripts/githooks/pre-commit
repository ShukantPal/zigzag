#!/bin/sh
# Convenience only: CI enforces that the materialized config is up to date.

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

if ! git diff --cached --name-only --diff-filter=ACMRD | grep -qx 'dept/config.py'; then
    exit 0
fi

artifact="$repo_root/dept/config.materialized.json"
temporary_dir=$(mktemp -d "${TMPDIR:-/tmp}/zigzag-config.XXXXXX") || {
    echo "warning: unable to create a materialization workspace; CI will check it" >&2
    exit 0
}
trap 'rm -rf "$temporary_dir"' EXIT HUP INT TERM
source="$temporary_dir/config.py"
temporary="$temporary_dir/config.materialized.json"

if ! git show :dept/config.py >"$source" || ! python3 "$source" --materialize >"$temporary"; then
    echo "warning: unable to materialize dept/config.materialized.json; CI will check it" >&2
    exit 0
fi

if ! mv "$temporary" "$artifact" || ! git add "$artifact"; then
    echo "warning: unable to stage dept/config.materialized.json; CI will check it" >&2
    rm -f "$temporary"
fi

exit 0
